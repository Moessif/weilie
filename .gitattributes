# 统一换行与二进制判定，避免跨平台 diff 噪音
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制（不参与文本换行转换）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.docx  binary
*.doc   binary
*.pdf   binary
*.so    binary
*.aar   binary
*.jar   binary
*.apk   binary
*.woff2 binary
*.ttf   binary
